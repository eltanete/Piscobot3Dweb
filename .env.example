# Copiar a .env y completar. Nunca subir .env al repositorio.

# Sitio
SITE_URL=http://localhost:4321
# true en staging: agrega noindex y bloquea robots.txt
PUBLIC_NOINDEX=false

# Email (SMTP de Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PISCOBOT 3D <no-reply@piscobot3d.com>"
MAIL_TO_LEADS=

# Cloudflare Turnstile (anti-spam)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Medición: Google Tag Manager (GA4, Google Ads y Clarity se configuran dentro de GTM). Ver docs/GTM.md
PUBLIC_GTM_ID=

# Keystatic (modo GitHub, sólo producción)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
