#!/bin/sh
# Bloquea commits directos en main y develop (ver CLAUDE.md → "Manejo de ramas").
# Los merges (git merge) no pasan por este hook, así que integrar ramas de tarea sigue funcionando.
rama=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$rama" = "main" ] || [ "$rama" = "develop" ]; then
  echo ""
  echo "✋ No se puede commitear directo en '$rama'."
  echo "   Creá una rama de tarea desde develop:"
  echo "     git switch develop && git pull origin develop"
  echo "     git switch -c feature/<nombre>"
  echo "   y al terminar mergeala a develop (ver CLAUDE.md)."
  echo ""
  exit 1
fi
exit 0
