---
// Espacio reservado con la proporción exacta de la foto que falta. Muestra el nombre de archivo
// esperado (convención caso-numero-formato.jpg) para que quien carga las fotos sepa qué va ahí.
interface Props {
  formato?: '16x9' | '4x3' | '1x1' | '4x5' | '3x4';
  archivo?: string;
  oscuro?: boolean;
  class?: string;
}

const { formato = '4x3', archivo, oscuro = true, class: className } = Astro.props;
const aspecto = {
  '16x9': 'aspect-[16/9]',
  '4x3': 'aspect-[4/3]',
  '1x1': 'aspect-square',
  '4x5': 'aspect-[4/5]',
  '3x4': 'aspect-[3/4]',
}[formato];
---

<div
  class:list={[
    'relative flex w-full items-center justify-center overflow-hidden',
    aspecto,
    oscuro ? 'bg-[#1a1c21] text-grafito-300' : 'bg-[#eceef1] text-grafito-700',
    className,
  ]}
  role="img"
  aria-label="Foto pendiente"
>
  <div
    class:list={['absolute inset-0', oscuro ? 'fondo-grilla' : 'fondo-grilla-clara']}
    aria-hidden="true"
  ></div>
  <div class="relative text-center font-mono text-[0.6875rem] tracking-wide uppercase">
    <svg
      viewBox="0 0 24 24"
      width="28"
      height="28"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="mx-auto mb-2"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <circle cx="9" cy="10" r="1.5"></circle>
      <path d="m21 16-5-5-8 8"></path>
    </svg>
    <span class="block">Foto pendiente · {formato.replace('x', ':')}</span>
    {archivo && <span class="mt-1 block normal-case opacity-80">{archivo}</span>}
  </div>
</div>
