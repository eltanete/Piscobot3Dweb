---
// Acordeón accesible basado en <details>/<summary> (sin JavaScript).
import Icon from './Icon.astro';

interface Item {
  pregunta: string;
  respuesta: string;
}

interface Props {
  items: Item[];
  /** Nombre de grupo: con el mismo name sólo queda un ítem abierto a la vez. */
  grupo?: string;
}

const { items, grupo } = Astro.props;
---

<div class="divide-y divide-grafito-200 border-y border-grafito-200">
  {items.map((item) => (
    <details name={grupo} class="group">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left font-medium text-grafito-950 marker:hidden hover:text-acento-texto [&::-webkit-details-marker]:hidden">
        <span class="text-[1.0625rem]">{item.pregunta}</span>
        <Icon
          name="chevron-down"
          class="mt-0.5 shrink-0 text-grafito-500 transition-transform duration-200 group-open:rotate-180"
        />
      </summary>
      <div class="pr-10 pb-6 leading-relaxed whitespace-pre-line text-grafito-600">
        {item.respuesta}
      </div>
    </details>
  ))}
</div>
