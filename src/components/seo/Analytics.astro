---
// Google Tag Manager + Consent Mode v2. Todo (GA4, Google Ads, remarketing, Clarity) se carga desde GTM:
// no hay etiquetas sueltas en el código. Ver docs/GTM.md para las etiquetas y disparadores.
// - Consentimiento por defecto DENEGADO; el banner lo actualiza (Aceptar / Rechazar).
// - GTM se carga async (no bloquea el render). Sin PUBLIC_GTM_ID no se carga, pero el dataLayer funciona.
// - Eventos: envio_formulario, clic_whatsapp, clic_telefono, clic_mail, armar_kit, clic_caso,
//   inicio_formulario, cierre_banner_campana (+ clic_cta genérico), con vertical, línea y página.
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
---

<script is:inline define:vars={{ gtmId }}>
  /* eslint-disable no-var, no-empty, prefer-rest-params, @typescript-eslint/no-unused-vars -- ES5 inline a propósito */
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () {
    window.dataLayer.push(arguments);
  };
  var guardado = null;
  try {
    guardado = localStorage.getItem('piscobot-consent');
  } catch (e) {}
  window.gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'granted',
    security_storage: 'granted',
    wait_for_update: 500,
  });
  if (guardado === 'si') {
    window.gtag('consent', 'update', {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
    });
  }
  if (gtmId) {
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s);
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', gtmId);
  }
</script>

<script>
  type DL = { push: (o: Record<string, unknown>) => void };
  const dl = () => ((window as unknown as { dataLayer: DL }).dataLayer ??= [] as unknown as DL);
  const contexto = () => ({
    vertical: document.body.dataset.vertical || 'general',
    linea: document.body.dataset.linea || '',
    pagina: location.pathname,
  });
  const CONOCIDOS = new Set([
    'envio_formulario',
    'clic_whatsapp',
    'clic_telefono',
    'clic_mail',
    'armar_kit',
    'clic_caso',
    'inicio_formulario',
    'cierre_banner_campana',
  ]);
  const ALIAS: Record<string, string> = { whatsapp_click: 'clic_whatsapp' };
  const enviar = (evento: string, params: Record<string, unknown> = {}) =>
    dl().push({ event: evento, ...contexto(), ...params });

  // Clics: WhatsApp / teléfono / mail se detectan por el destino; el resto por data-evento.
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('a, button');
    if (!el) return;
    const href = el.getAttribute('href') ?? '';
    if (/^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(href)) return enviar('clic_whatsapp');
    if (href.startsWith('tel:')) return enviar('clic_telefono');
    if (href.startsWith('mailto:')) return enviar('clic_mail');
    const nombre = el.dataset.evento;
    if (!nombre) return;
    const normal = ALIAS[nombre] ?? nombre;
    if (CONOCIDOS.has(normal)) enviar(normal, { texto: el.textContent?.trim().slice(0, 80) });
    else enviar('clic_cta', { cta: normal, texto: el.textContent?.trim().slice(0, 80) });
  });

  // Eventos emitidos por los componentes (formularios, kit, banner, chat).
  window.addEventListener('piscobot:evento', (e) => {
    const { nombre, params } = (
      e as CustomEvent<{ nombre: string; params?: Record<string, unknown> }>
    ).detail;
    enviar(ALIAS[nombre] ?? nombre, params ?? {});
  });
</script>
