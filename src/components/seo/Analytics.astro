---
// GA4 + Microsoft Clarity, cargados sólo si hay IDs configurados y el visitante aceptó cookies.
// Eventos: cualquier elemento con data-evento="nombre" envía ese evento al hacer clic,
// junto con la vertical de la página (data-vertical del <body>).
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID ?? '';
const activo = Boolean(gaId || clarityId);
---

{activo && (
  <>
    <div
      id="consentimiento"
      hidden
      class="fixed inset-x-3 bottom-24 z-50 mx-auto max-w-xl rounded-lg border border-grafito-200 bg-white p-4 text-sm shadow-elevada md:bottom-6"
      role="dialog"
      aria-label="Preferencias de cookies"
    >
      <p class="text-grafito-700">
        Usamos cookies de analítica para entender cómo se usa el sitio y mejorarlo. No las usamos
        para publicidad.
      </p>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-consent="si"
          class="rounded-md bg-grafito-950 px-4 py-2 font-semibold text-white"
        >
          Aceptar
        </button>
        <button
          type="button"
          data-consent="no"
          class="rounded-md border border-grafito-300 px-4 py-2 font-semibold"
        >
          Rechazar
        </button>
      </div>
    </div>
    <script is:inline define:vars={{ gaId, clarityId }}>
      /* eslint-disable no-var, prefer-rest-params, no-empty, @typescript-eslint/no-unused-vars -- ES5 inline a propósito */
      (function () {
        var KEY = 'piscobot-consent';
        var leer = function () {
          try {
            return localStorage.getItem(KEY);
          } catch (e) {
            return null;
          }
        };
        var guardar = function (v) {
          try {
            localStorage.setItem(KEY, v);
          } catch (e) {}
        };
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        var cargar = function () {
          if (gaId) {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            window.gtag('js', new Date());
            window.gtag('config', gaId, { anonymize_ip: true });
          }
          if (clarityId) {
            (function (c, l, a, r, i, t, y) {
              c[a] =
                c[a] ||
                function () {
                  (c[a].q = c[a].q || []).push(arguments);
                };
              t = l.createElement(r);
              t.async = 1;
              t.src = 'https://www.clarity.ms/tag/' + i;
              y = l.getElementsByTagName(r)[0];
              y.parentNode.insertBefore(t, y);
            })(window, document, 'clarity', 'script', clarityId);
          }
        };
        var estado = leer();
        if (estado === 'si') cargar();
        document.addEventListener('DOMContentLoaded', function () {
          var banner = document.getElementById('consentimiento');
          if (!estado && banner) banner.hidden = false;
          document.querySelectorAll('[data-consent]').forEach(function (b) {
            b.addEventListener('click', function () {
              var v = b.getAttribute('data-consent');
              guardar(v);
              if (banner) banner.hidden = true;
              if (v === 'si') cargar();
            });
          });
        });
        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('[data-evento]');
          if (!el) return;
          window.gtag('event', el.getAttribute('data-evento'), {
            vertical: document.body.dataset.vertical || 'general',
            pagina: location.pathname,
          });
        });
        window.addEventListener('piscobot:evento', function (e) {
          window.gtag(
            'event',
            e.detail.nombre,
            Object.assign(
              {
                vertical: document.body.dataset.vertical || 'general',
              },
              e.detail.params || {},
            ),
          );
        });
      })();
    </script>
  </>
)}
