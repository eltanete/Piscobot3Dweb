---
import { rutaLimpia } from '../../lib/ruta';
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { NAV_VERTICALES, NAV_COMUNES } from '../../lib/nav';

const path = rutaLimpia(Astro.url);
const activo = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-grafito-200/80 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <a
    href="#contenido"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2"
  >
    Saltar al contenido
  </a>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 md:px-8">
    <a href="/" aria-label="PISCOBOT 3D — Inicio" class="shrink-0">
      <Logo />
    </a>

    <!-- Navegación desktop -->
    <nav aria-label="Principal" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {NAV_VERTICALES.map((grupo) => (
          <li class="group/menu relative" data-vertical={grupo.vertical}>
            <a
              href={grupo.href}
              class:list={[
                'flex items-center gap-1 rounded-md px-3 py-2 text-[0.9375rem] font-medium hover:bg-grafito-100',
                activo(grupo.href) && 'text-acento-texto',
              ]}
              aria-current={path === grupo.href ? 'page' : undefined}
            >
              <span class="size-1.5 rounded-full bg-acento" aria-hidden="true" />
              {grupo.label}
              <Icon
                name="chevron-down"
                size={16}
                class="transition-transform group-focus-within/menu:rotate-180 group-hover/menu:rotate-180"
              />
            </a>
            <div class="invisible absolute top-full left-0 pt-2 opacity-0 transition-all duration-150 group-focus-within/menu:visible group-focus-within/menu:opacity-100 group-hover/menu:visible group-hover/menu:opacity-100">
              <ul class="w-80 rounded-lg border border-grafito-200 bg-white p-2 shadow-elevada">
                {grupo.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="block rounded-md px-3 py-2.5 hover:bg-acento-suave"
                      aria-current={activo(item.href) ? 'page' : undefined}
                    >
                      <span class="block font-medium text-grafito-950">{item.label}</span>
                      <span class="mt-0.5 block text-sm text-grafito-600">{item.descripcion}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
        {NAV_COMUNES.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-md px-3 py-2 text-[0.9375rem] font-medium hover:bg-grafito-100',
                activo(item.href) && 'text-azul-600',
              ]}
              aria-current={activo(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <Button href="/cotizar" tamano="sm" class="hidden sm:inline-flex" evento="cta_header_cotizar">
        Cotizar proyecto
      </Button>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-md hover:bg-grafito-100 xl:hidden"
        aria-controls="menu-mobile"
        aria-expanded="false"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Icon name="menu" size={24} class="[[aria-expanded=true]>&]:hidden" />
        <Icon name="x" size={24} class="hidden [[aria-expanded=true]>&]:block" />
      </button>
    </div>
  </div>

  <!-- Menú mobile -->
  <div
    id="menu-mobile"
    class="fixed inset-x-0 top-16 bottom-0 hidden overflow-y-auto border-t border-grafito-200 bg-white xl:hidden"
    data-menu
  >
    <nav aria-label="Principal mobile" class="mx-auto max-w-7xl px-4 pt-4 pb-32">
      {NAV_VERTICALES.map((grupo) => (
        <div class="border-b border-grafito-200 py-4" data-vertical={grupo.vertical}>
          <a href={grupo.href} class="flex items-center gap-2 py-2 text-lg font-semibold">
            <span class="size-2 rounded-full bg-acento" aria-hidden="true" />
            {grupo.label}
          </a>
          <ul class="mt-1">
            {grupo.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-md py-2.5 pl-4 text-grafito-700 hover:bg-grafito-50"
                  aria-current={activo(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <ul class="py-4">
        {NAV_COMUNES.map((item) => (
          <li>
            <a href={item.href} class="block py-2.5 text-lg font-medium">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button href="/cotizar" bloque tamano="lg">
        Cotizar proyecto
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const set = (abierto: boolean) => {
      toggle.setAttribute('aria-expanded', String(abierto));
      toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
      menu.classList.toggle('hidden', !abierto);
      document.documentElement.classList.toggle('overflow-hidden', abierto);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
    window
      .matchMedia('(min-width: 80rem)')
      .addEventListener('change', (e) => e.matches && set(false));
  }
</script>
