---
// Página provisoria hasta que cada ruta se construya en la Fase 4.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Vertical } from '../../lib/constants';

interface Props {
  title: string;
  vertical?: Vertical;
}

const { title, vertical } = Astro.props;
---

<BaseLayout title={title} vertical={vertical}>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-4 px-4">
    <p class="font-mono text-sm text-marca">{Astro.url.pathname}</p>
    <h1 class="text-3xl font-bold">{title}</h1>
    <p>Página en construcción.</p>
    <a class="underline" href="/">
      Volver al inicio
    </a>
  </main>
</BaseLayout>
