---
// Isotipo oficial (hexágono con cubo) + wordmark en texto.
import { Image } from 'astro:assets';
import isotipo from '../../assets/images/marca/isotipo.png';

interface Props {
  oscuro?: boolean;
  class?: string;
}
const { oscuro = false, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 leading-none', className]}>
  <Image src={isotipo} alt="" width={36} height={36} class="size-9 rounded-md" loading="eager" />
  <span
    class:list={[
      'text-[1.125rem] font-extrabold tracking-[-0.03em]',
      oscuro ? 'text-white' : 'text-grafito-950',
    ]}
  >
    PISCOBOT <span class="text-azul-600">3D</span>
  </span>
</span>
