---
// Bloque clave de la Home: dos caminos de igual peso visual, uno por vertical.
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { NAV_VERTICALES } from '../../lib/nav';
import imgIndustria from '../../assets/images/paginas/bifurcacion-industria.webp';
import imgMarcas from '../../assets/images/paginas/bifurcacion-marcas.webp';

interface Textos {
  titulo: string;
  texto: string;
  cta: string;
}

interface Props {
  industria: Textos;
  marcas: Textos;
}

const { industria, marcas } = Astro.props;
const tarjetas = NAV_VERTICALES.map((g) => ({
  ...g,
  textos: g.vertical === 'industria' ? industria : marcas,
  imagen: g.vertical === 'industria' ? imgIndustria : imgMarcas,
  alt:
    g.vertical === 'industria'
      ? 'Granja de impresoras 3D Prusa en producción'
      : 'Exhibidores impresos en 3D para una marca',
}));
---

<div class="grid gap-4 md:grid-cols-2 md:gap-6">
  {tarjetas.map((t) => (
    <a
      href={t.href}
      data-vertical={t.vertical}
      data-evento="vertical_elegida"
      class="group relative flex flex-col overflow-hidden rounded-xl border-2 border-grafito-200 bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-acento hover:shadow-elevada"
    >
      <span class="absolute inset-x-0 top-0 z-10 h-1.5 bg-acento" aria-hidden="true" />
      <div class="relative aspect-[16/7] overflow-hidden">
        <Image
          src={t.imagen}
          alt={t.alt}
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-white via-white/10 to-transparent"
          aria-hidden="true"
        />
      </div>
      <div class="flex flex-1 flex-col px-7 pb-7 md:px-10 md:pb-10">
        <span class="eyebrow mb-4 text-acento-texto">
          {t.vertical === 'industria' ? 'Para tu industria' : 'Para tu marca'}
        </span>
        <h3 class="text-titulo">{t.textos.titulo}</h3>
        <p class="text-bajada mt-4 text-grafito-600">{t.textos.texto}</p>
        <ul class="mt-6 space-y-2">
          {t.items.map((i) => (
            <li class="flex items-center gap-2 text-grafito-800">
              <Icon name="check" size={18} class="text-acento-texto" />
              {i.label}
            </li>
          ))}
        </ul>
        <span class="mt-8 inline-flex items-center gap-2 self-start rounded-md bg-acento px-5 py-3 font-semibold text-sobre-acento transition-colors group-hover:bg-acento-hover">
          {t.textos.cta}
          <Icon
            name="arrow-right"
            size={18}
            class="transition-transform group-hover:translate-x-0.5"
          />
        </span>
      </div>
    </a>
  ))}
</div>
