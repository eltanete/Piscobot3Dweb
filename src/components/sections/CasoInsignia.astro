---
// Tarjeta grande de caso insignia: foto (o placeholder 16:9), datos en monoespaciada y CTA al caso.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import Icon from '../ui/Icon.astro';
import { fotosDe, nombreCliente } from '../../lib/casos';

interface Props {
  caso: CollectionEntry<'casos'>;
  compacto?: boolean;
}

const { caso, compacto = false } = Astro.props;
const d = caso.data;
const cliente = nombreCliente(caso);
const portada = fotosDe(caso)[0];
---

<a
  href={`/casos/${caso.id}`}
  data-vertical={d.vertical}
  data-evento="clic_caso"
  class:list={[
    'group grid w-full overflow-hidden rounded-xl bg-grafito-950 text-white transition-shadow hover:shadow-elevada',
    !compacto && 'md:grid-cols-2',
  ]}
>
  <div class="relative overflow-hidden">
    {portada ? (
      <Image
        src={portada.src}
        alt={portada.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="aspect-[16/9] size-full object-cover transition-transform duration-500 group-hover:scale-[1.03] md:aspect-auto"
      />
    ) : (
      <ImagePlaceholder
        formato="16x9"
        archivo={`${caso.id.split('-')[0]}-01-16x9.jpg`}
        class="h-full"
      />
    )}
  </div>
  <div class:list={['flex flex-col', compacto ? 'p-6' : 'p-7 md:p-10']}>
    <p class="eyebrow mb-3 flex items-center gap-2 text-grafito-400">
      <span class="size-2 rounded-full bg-acento" aria-hidden="true"></span>
      Caso insignia{cliente ? ` · ${cliente}` : ''}
    </p>
    <h3 class="text-subtitulo text-white">{d.titulo}</h3>
    {d.bajada && <p class="mt-3 text-grafito-300">{d.bajada}</p>}
    {d.datos.length > 0 && (
      <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-grafito-800 pt-5">
        {d.datos.slice(0, 4).map((x) => (
          <div>
            <dt class="sr-only">{x.etiqueta}</dt>
            <dd class="font-mono text-2xl font-semibold text-white">{x.valor}</dd>
            <dd class="text-xs text-grafito-400">{x.etiqueta}</dd>
          </div>
        ))}
      </dl>
    )}
    <span class="mt-auto inline-flex items-center gap-2 pt-7 font-semibold text-white">
      Ver el caso
      <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
