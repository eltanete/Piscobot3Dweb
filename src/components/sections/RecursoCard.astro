---
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
  recurso: CollectionEntry<'recursos'>;
}
const { recurso } = Astro.props;
const d = recurso.data;
---

<a
  href={`/recursos/${recurso.id}`}
  class="group flex h-full flex-col rounded-lg border border-grafito-200 bg-white p-6 transition-all hover:border-grafito-900 hover:shadow-tarjeta"
>
  <div class="mb-4 flex items-center justify-between">
    <span class="inline-flex size-10 items-center justify-center rounded-md bg-grafito-100 text-grafito-800">
      <Icon name={d.icono} size={20} />
    </span>
    <span class="font-mono text-xs tracking-wide text-grafito-500 uppercase">{d.categoria}</span>
  </div>
  <h3 class="text-lg leading-snug group-hover:text-azul-600">{d.titulo}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-grafito-600">{d.descripcion}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-azul-600">
    Leer guía <Icon name="arrow-right" size={16} />
  </span>
</a>
