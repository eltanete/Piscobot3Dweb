---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Stat from '../ui/Stat.astro';

interface Props {
  eyebrow?: string;
  titulo: string;
  bajada?: string;
  migas?: { label: string; href?: string }[];
  pruebas?: { valor: string; etiqueta: string }[];
  compacto?: boolean;
  imagen?: ImageMetadata;
  imagenAlt?: string;
}

const {
  eyebrow,
  titulo,
  bajada,
  migas,
  pruebas = [],
  compacto = false,
  imagen,
  imagenAlt = '',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-grafito-950 text-white">
  <div class="fondo-grilla absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
  <div
    class="absolute -top-40 -right-40 -z-10 size-[32rem] rounded-full bg-acento opacity-25 blur-[120px]"
    aria-hidden="true"
  ></div>
  <Container class:list={[compacto ? 'py-14 md:py-20' : 'py-16 md:py-24']}>
    {migas && <Breadcrumbs items={migas} oscuro />}
    <div class:list={[imagen ? 'grid items-center gap-10 xl:grid-cols-12' : '']}>
      <div class:list={[imagen ? 'xl:col-span-7' : 'max-w-4xl']}>
        {eyebrow && (
          <p class="eyebrow mb-4 flex items-center gap-2 text-grafito-300">
            <span class="size-2 rounded-full bg-acento" aria-hidden="true" />
            {eyebrow}
          </p>
        )}
        <h1 class:list={[compacto ? 'text-titulo' : 'text-display', 'text-white']}>{titulo}</h1>
        {bajada && <p class="text-bajada mt-6 max-w-2xl text-grafito-300">{bajada}</p>}
        {Astro.slots.has('default') && (
          <div class="mt-8 flex flex-wrap gap-3">
            <slot />
          </div>
        )}
      </div>
      {imagen && (
        <div class="relative xl:col-span-5">
          <div
            class="absolute -inset-3 -z-10 rounded-2xl bg-acento opacity-20 blur-2xl"
            aria-hidden="true"
          />
          <Image
            src={imagen}
            alt={imagenAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1280px) 480px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full rounded-xl border border-grafito-800 object-cover"
          />
        </div>
      )}
    </div>
    {pruebas.length > 0 && (
      <dl class="mt-14 grid grid-cols-2 gap-6 border-t border-grafito-800 pt-8 md:grid-cols-3">
        {pruebas.map((p) => (
          <Stat valor={p.valor} etiqueta={p.etiqueta} oscuro />
        ))}
      </dl>
    )}
  </Container>
</section>
