---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  caso: CollectionEntry<'casos'>;
}

const { caso } = Astro.props;
const d = caso.data;
---

<a
  href={`/casos/${caso.id}`}
  data-vertical={d.vertical}
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-grafito-200 bg-white shadow-tarjeta transition-all hover:-translate-y-0.5 hover:shadow-elevada"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-grafito-900">
    {d.imagen ? (
      <Image
        src={d.imagen}
        alt={d.imagenAlt ?? d.titulo}
        widths={[400, 800]}
        sizes="(min-width: 1280px) 400px, (min-width: 768px) 50vw, 100vw"
        class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="fondo-grilla flex size-full items-end p-5">
        <span
          class="absolute top-1/2 left-1/2 size-32 -translate-x-1/2 -translate-y-1/2 rounded-full bg-acento opacity-30 blur-3xl"
          aria-hidden="true"
        />
        <Icon
          name="box"
          size={56}
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-white/30"
        />
        <span class="relative font-mono text-xs text-grafito-400">{d.material}</span>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap gap-2">
      <Badge tono={d.vertical}>{d.vertical === 'industria' ? 'Industria' : 'Marcas'}</Badge>
      <Badge>{d.material}</Badge>
      {d.ejemplo && <Badge>Ejemplo</Badge>}
    </div>
    <h3 class="text-lg leading-snug">{d.titulo}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-grafito-600">{d.resumen}</p>
    <dl class="mt-4 border-t border-grafito-200 pt-4 font-mono text-xs text-grafito-500">
      <dt class="sr-only">Aplicación</dt>
      <dd>{d.aplicacion}</dd>
    </dl>
  </div>
</a>
