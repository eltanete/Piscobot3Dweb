---
// Tarjeta de caso (ficha o insignia). Las fichas abren el modal de /casos (#slug).
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Badge from '../ui/Badge.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import { fotosDe, nombreCliente, urlCaso } from '../../lib/casos';
import { VERTICALES } from '../../lib/constants';

interface Props {
  caso: CollectionEntry<'casos'>;
}

const { caso } = Astro.props;
const d = caso.data;
const portada = fotosDe(caso)[0];
const cliente = nombreCliente(caso);
const esFicha = d.nivel !== 'insignia';
---

<a
  href={urlCaso(caso)}
  data-vertical={d.vertical}
  data-evento="clic_caso"
  data-abrir-ficha={esFicha ? caso.id : undefined}
  class="group flex h-full flex-col overflow-hidden rounded-lg border-2 border-grafito-200 bg-white transition-all hover:-translate-y-0.5 hover:border-acento hover:shadow-elevada"
>
  <div class="relative overflow-hidden">
    {portada ? (
      <Image
        src={portada.src}
        alt={portada.alt}
        widths={[400, 800]}
        sizes="(min-width: 1280px) 400px, (min-width: 768px) 50vw, 100vw"
        class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : (
      <ImagePlaceholder formato="4x3" archivo={`${caso.id}-01-4x3.jpg`} />
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap gap-2">
      <Badge tono={d.vertical}>{VERTICALES[d.vertical].corto}</Badge>
      {d.nivel === 'insignia' && <Badge tono="acento">Insignia</Badge>}
      {d.material && <Badge>{d.material}</Badge>}
    </div>
    <h3 class="text-lg leading-snug">{d.titulo}</h3>
    {cliente && <p class="mt-1 text-sm text-grafito-500">{cliente}</p>}
    <p class="mt-2 flex-1 text-sm leading-relaxed text-grafito-600">{d.resumen}</p>
    <span class="mt-4 text-sm font-semibold text-acento-texto">
      {esFicha ? 'Ver ficha' : 'Ver el caso'} →
    </span>
  </div>
</a>
