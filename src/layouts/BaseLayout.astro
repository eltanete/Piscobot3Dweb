---
import { rutaLimpia } from '../lib/ruta';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileCtaBar from '../components/layout/MobileCtaBar.astro';
import WhatsAppChat from '../components/layout/WhatsAppChat.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Analytics from '../components/seo/Analytics.astro';
import BannerCampana from '../components/campana/BannerCampana.astro';
import BannerCookies from '../components/seo/BannerCookies.astro';
import { SITE, sitio, type Vertical } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
  vertical?: Vertical;
  /** Imagen para redes (ruta absoluta en /public o URL). */
  ogImage?: string;
  /** Imagen OG generada desde una foto de la página (1200×630, recorte centrado). */
  ogImagen?: ImageMetadata;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** CTA principal de la barra mobile. */
  cta?: { label: string; href: string };
  mensajeWhatsapp?: string;
  /** Oculta header/footer (p. ej. styleguide). */
  minimal?: boolean;
  /** Muestra el banner de la campaña de fin de año (Home y /marcas). */
  bannerCampana?: boolean;
  /** Línea de negocio de la página (para eventos del dataLayer). */
  linea?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  vertical,
  ogImage = '/og/default.jpg',
  ogImagen,
  ogType = 'website',
  noindex = false,
  cta,
  mensajeWhatsapp,
  minimal = false,
  bannerCampana = false,
  linea,
  schema,
} = Astro.props;

const fullTitle =
  title === SITE.name ? `${SITE.name} — ${sitio.eslogan}` : `${title} | ${SITE.name}`;
const canonical = new URL(rutaLimpia(Astro.url), Astro.site).href;
const ogGenerada = ogImagen
  ? await getImage({
      src: ogImagen,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
      quality: 80,
    })
  : null;
const ogUrl = new URL(ogGenerada?.src ?? ogImage, Astro.site).href;
// Los entornos de prueba (PUBLIC_NOINDEX=true) nunca se indexan.
const robots =
  noindex || import.meta.env.PUBLIC_NOINDEX === 'true' ? 'noindex, nofollow' : 'index, follow';

const organizacion = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': new URL('/#organizacion', Astro.site).href,
  name: sitio.nombre,
  description: sitio.descripcion,
  url: Astro.site?.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  image: ogUrl,
  email: sitio.email,
  telephone: sitio.telefono,
  address: {
    '@type': 'PostalAddress',
    streetAddress: sitio.direccion,
    addressLocality: sitio.ciudad,
    addressRegion: sitio.region,
    addressCountry: sitio.pais,
    postalCode: sitio.codigoPostal,
  },
  geo: { '@type': 'GeoCoordinates', latitude: sitio.geo.lat, longitude: sitio.geo.lng },
  openingHoursSpecification: [
    { opens: '10:00', closes: '13:00' },
    { opens: '14:00', closes: '17:00' },
  ].map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    ...h,
  })),
  areaServed: 'Argentina',
  priceRange: '$',
  sameAs: Object.values(sitio.redes).filter(Boolean),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1a1c21" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <JsonLd data={organizacion} />
    {schema && <JsonLd data={schema} />}
    <slot name="head" />
    <Analytics />
  </head>
  <body data-vertical={vertical} data-linea={linea} class="flex min-h-screen flex-col">
    {!minimal && bannerCampana && <BannerCampana />}
    {!minimal && <Header />}
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    {!minimal && <Footer />}
    {!minimal && (
      <MobileCtaBar ctaLabel={cta?.label} ctaHref={cta?.href} mensajeWhatsapp={mensajeWhatsapp} />
    )}
    {!minimal && <WhatsAppChat />}
    <BannerCookies />
    <script is:inline>
      /* eslint-disable no-var, @typescript-eslint/no-unused-vars -- ES5 inline a propósito */
      // Atribución: guarda gclid y utm_* de la visita (primer toque) y la última página vista,
      // para adjuntarlos al formulario de cotización. Nada de datos personales en la URL.
      (function () {
        try {
          var q = new URLSearchParams(location.search);
          var claves = [
            'gclid',
            'utm_source',
            'utm_medium',
            'utm_campaign',
            'utm_term',
            'utm_content',
          ];
          var actual = JSON.parse(sessionStorage.getItem('piscobot-atribucion') || '{}');
          claves.forEach(function (k) {
            if (q.get(k) && !actual[k]) actual[k] = q.get(k).slice(0, 200);
          });
          sessionStorage.setItem('piscobot-atribucion', JSON.stringify(actual));
          if (location.pathname.indexOf('/cotizar') !== 0)
            sessionStorage.setItem('piscobot-origen', location.pathname);
        } catch (e) {
          /* sin almacenamiento */
        }
      })();
    </script>
    <script is:inline>
      // Apaga todo lo marcado con data-campana-cierre (banner, ítem de menú, cuenta regresiva)
      // cuando pasa la fecha de cierre de la campaña, aunque el sitio no se haya vuelto a publicar.
      document.querySelectorAll('[data-campana-cierre]').forEach(function (el) {
        if (Date.now() > Date.parse(el.getAttribute('data-campana-cierre'))) el.remove();
      });
    </script>
  </body>
</html>
