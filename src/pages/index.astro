---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/constants';
---

<BaseLayout title={SITE.name}>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-6 px-4">
    <p class="font-mono text-sm text-marca">Fase 1 · scaffold</p>
    <h1 class="text-4xl font-bold">{SITE.name}</h1>
    <p class="text-lg">Nuevo sitio en construcción.</p>
    <div class="flex flex-wrap gap-3">
      <a class="rounded bg-marca px-4 py-2 text-white" href="/industria">
        Industria y Técnica
      </a>
      <a class="rounded bg-acento-marcas px-4 py-2 text-white" href="/marcas">
        Marcas y Agencias
      </a>
    </div>
  </main>
</BaseLayout>
