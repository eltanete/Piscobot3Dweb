---
import VerticalLayout from '../../layouts/VerticalLayout.astro';
import { MENSAJES_WHATSAPP } from '../../lib/whatsapp';
import imagenHero from '../../assets/images/paginas/empresas-hero.webp';
---

<VerticalLayout
  vertical="industria"
  hero={{
    imagen: imagenHero,
    imagenAlt: 'Técnico frente a impresoras 3D industriales Ultimaker',
    eyebrow: 'Empresas e Industrias',
    titulo: 'Impresión 3D que funciona en producción, no sólo en la vidriera',
    bajada:
      'Servicio técnico, capacitaciones, impresión de piezas funcionales y desarrollo de productos, con el respaldo de quienes conocen la tecnología por dentro.',
  }}
  seo={{
    titulo: 'Impresión 3D para empresas e industrias en CABA',
    descripcion:
      'Servicio técnico de impresoras 3D, capacitación en planta, impresión 3D en cantidad y desarrollo de productos para empresas e industrias en Buenos Aires.',
  }}
  cta={{ label: 'Agendar diagnóstico', tipo: 'servicio-tecnico' }}
  whatsapp={MENSAJES_WHATSAPP.servicioTecnico}
  paraQuien={[
    {
      titulo: 'Empresas y fábricas',
      texto: 'Que usan impresión 3D para repuestos, herramental o prototipos.',
      icono: 'settings',
    },
    {
      titulo: 'Escuelas e institutos',
      texto: 'Con laboratorios y parques de impresoras para mantener y aprovechar.',
      icono: 'graduation-cap',
    },
    {
      titulo: 'Estudios y desarrolladores',
      texto: 'Que necesitan pasar de una idea a una pieza fabricable.',
      icono: 'box',
    },
    {
      titulo: 'Makers y particulares',
      texto: 'Con su propia impresora y ganas de que funcione bien.',
      icono: 'users',
    },
  ]}
  tipos={['servicio-tecnico', 'capacitaciones', 'impresion']}
/>
