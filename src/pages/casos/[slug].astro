---
// Caso insignia (nivel 1). Las fichas no tienen página: se abren en el modal de /casos.
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import ImagePlaceholder from '../../components/ui/ImagePlaceholder.astro';
import ModelViewer from '../../components/islands/ModelViewer.astro';
import CasoCard from '../../components/sections/CasoCard.astro';
import { VERTICALES } from '../../lib/constants';
import { ctaCaso, fotosDe, nombreCliente, publicable } from '../../lib/casos';
import { whatsappUrl } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const casos = await getCollection('casos', (c) => publicable(c) && c.data.nivel === 'insignia');
  return casos.map((caso) => ({ params: { slug: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const d = caso.data;
const { Content } = await render(caso);
const v = VERTICALES[d.vertical];
const linea = await getEntry('servicios', d.servicio);
const cliente = nombreCliente(caso);
const fotos = fotosDe(caso);
const portada = fotos[0];
const galeria = fotos.slice(1, 8);
// Completa la galería hasta 6 lugares con placeholders mientras llegan las fotos.
const faltantes = Math.max(0, 6 - galeria.length);
const cta = ctaCaso(caso);
const prefijo = caso.id.split('-')[0];

const relacionados = (
  await getCollection(
    'casos',
    (c) =>
      publicable(c) &&
      c.id !== caso.id &&
      c.data.vertical === d.vertical &&
      c.data.nivel !== 'galeria',
  )
)
  .sort(
    (a, b) =>
      Number(b.data.servicio === d.servicio) - Number(a.data.servicio === d.servicio) ||
      a.data.orden - b.data.orden,
  )
  .slice(0, 3);

const bloques = [
  { titulo: 'Desafío', texto: d.desafio },
  { titulo: 'Solución', texto: d.solucion },
  { titulo: 'Resultado', texto: d.resultado },
].filter((b) => b.texto);
---

<BaseLayout
  title={`${d.titulo}${cliente ? ` — ${cliente}` : ''}`}
  description={d.bajada ?? d.resumen}
  vertical={d.vertical}
  ogType="article"
  cta={{ label: 'Quiero algo así', href: `/cotizar?vertical=${d.vertical}` }}
>
  <section class="bg-grafito-950 text-white">
    <Container class="pt-10 pb-12 md:pt-14">
      <Breadcrumbs items={[{ label: 'Casos', href: '/casos' }, { label: d.titulo }]} oscuro />
      <p class="eyebrow mb-4 flex items-center gap-2 text-grafito-400">
        <span class="size-2 rounded-full bg-acento" aria-hidden="true"></span>
        {v.nombre}
        {linea ? ` · ${linea.data.titulo}` : ''}
        {cliente ? ` · ${cliente}` : ''}
      </p>
      <h1 class="text-display max-w-5xl text-white">{d.titulo}</h1>
      {d.bajada && <p class="text-bajada mt-6 max-w-3xl text-grafito-300">{d.bajada}</p>}
      {d.datos.length > 0 && (
        <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-grafito-800 pt-8 md:grid-cols-4">
          {d.datos.slice(0, 4).map((x) => (
            <div>
              <dt class="sr-only">{x.etiqueta}</dt>
              <dd class="font-mono text-3xl font-semibold text-white md:text-4xl">{x.valor}</dd>
              <dd class="mt-1 text-sm text-grafito-400">{x.etiqueta}</dd>
            </div>
          ))}
        </dl>
      )}
    </Container>
    <div class="mx-auto max-w-7xl px-4 pb-12 md:px-8">
      {d.modelo3d ? (
        <ModelViewer src={d.modelo3d} alt={`Modelo 3D: ${d.titulo}`} />
      ) : portada ? (
        <Image
          src={portada.src}
          alt={portada.alt}
          widths={[800, 1400, 2400]}
          sizes="(min-width: 1280px) 1216px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] w-full rounded-xl object-cover"
        />
      ) : (
        <ImagePlaceholder formato="16x9" archivo={`${prefijo}-01-16x9.jpg`} class="rounded-xl" />
      )}
    </div>
  </section>

  {bloques.length > 0 && (
    <Section>
      <div class="grid gap-10 md:grid-cols-3">
        {bloques.map((b) => (
          <div>
            <h2 class="eyebrow mb-3 text-acento-texto">{b.titulo}</h2>
            <p class="text-[1.0625rem] leading-relaxed text-grafito-800">{b.texto}</p>
          </div>
        ))}
      </div>
      <div class="prose-piscobot mt-10">
        <Content />
      </div>
    </Section>
  )}

  <Section fondo="gris" aria-labelledby="titulo-galeria-caso">
    <SectionHeader id="titulo-galeria-caso" eyebrow="Galería" titulo="El trabajo, en fotos" />
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {galeria.map((f) => (
        <li class="overflow-hidden rounded-lg">
          <Image
            src={f.src}
            alt={f.alt}
            widths={[400, 800]}
            sizes="(min-width: 768px) 33vw, 50vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </li>
      ))}
      {Array.from({ length: faltantes }, (_, i) => (
        <li class="overflow-hidden rounded-lg">
          <ImagePlaceholder
            formato="4x3"
            archivo={`${prefijo}-${String(galeria.length + i + 2).padStart(2, '0')}-4x3.jpg`}
            oscuro={false}
          />
        </li>
      ))}
    </ul>
  </Section>

  {relacionados.length > 0 && (
    <Section aria-labelledby="titulo-relacionados">
      <SectionHeader id="titulo-relacionados" eyebrow="Seguí viendo" titulo="Casos relacionados" />
      <ul class="grid gap-6 md:grid-cols-3">
        {relacionados.map((c) => (
          <li>
            <CasoCard caso={c} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section fondo="oscuro">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-titulo">
          ¿Querés algo así para tu {d.vertical === 'marcas' ? 'marca' : 'empresa'}?
        </h2>
        {linea && (
          <p class="mt-2 text-grafito-300">Conocé la línea {linea.data.titulo.toLowerCase()}.</p>
        )}
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href={cta.href} variante="claro" tamano="lg" iconoFinal="arrow-right">
          {cta.label}
        </Button>
        <Button
          href={whatsappUrl(`Hola PISCOBOT 3D, vi el caso "${d.titulo}" y quiero algo así.`)}
          variante="whatsapp"
          tamano="lg"
          icono="message"
          evento="clic_whatsapp"
        >
          WhatsApp
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
